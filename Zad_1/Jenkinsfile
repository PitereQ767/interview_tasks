pipeline {
  agent any

  options {
    skipDefaultCheckout(true)
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Prepare') {
      steps {
        sh 'chmod +x ./Zad_1/check-logs.sh'
      }
    }

    stage('Check logs') {
      steps {
        sh '''#!/bin/bash
          set -o pipefail
          ./Zad_1/check-logs.sh ./Zad_1/logs | tee check-logs-output.txt
        '''
      }
    }
  }

  post {
    always {
      archiveArtifacts artifacts: 'check-logs-output.txt', allowEmptyArchive: true
    }
  }
}
