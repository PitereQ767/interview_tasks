pipeline {
    agent any

    parameters {
        choice(
            name: 'DEPLOY_ENV',
            choices: ['dev', 'staging', 'prod'],
            description: 'Environment selected for deployment'
        )
    }

    environment {
        ARTIFACT = "app-${BUILD_NUMBER}.tar.gz"
    }

    stages {
        stage('Prepare') {
            steps {
                echo "Selected environment: ${params.DEPLOY_ENV}"

                sh 'echo "Before cleanup:"'
                sh 'ls -la'

                sh 'rm -rf out'
                sh 'rm -f ./*.tar.gz'

                sh 'echo "After cleanup:"'
                sh 'ls -la'

                sh 'mkdir -p out'
                sh 'echo "version=1.0.${BUILD_NUMBER}" > out/version.txt'
            }
        }

        stage('Package') {
            steps {
                sh 'tar czf ${ARTIFACT} out/'
            }
        }

        stage('Report') {
            steps {
                sh 'echo "Packaged ${ARTIFACT}"'
            }
        }
    }
}
